/* General Reset */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    line-height: 1.6;
    color: #2d3748;
    background-color: #f7fafc;
}

/* Navigation Bar */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #1a202c;
    padding: 1rem 2rem;
    position: sticky;
    top: 0;
    z-index: 1000;
}

.logo {
    color: #ffffff;
    font-weight: bold;
    font-size: 1.25rem;
}

.nav-links {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1.5rem;
}

.nav-links a {
    color: #e2e8f0;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
}

.nav-links a:hover {
    color: #3182ce;
}

.btn-nav {
    background-color: #3182ce;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    color: #ffffff !important;
}

.btn-nav:hover {
    background-color: #2b6cb0;
}

/* Hero Section */
.hero {
    background: linear-gradient(135deg, #2b6cb0 0%, #1a202c 100%);
    color: #ffffff;
    text-align: center;
    padding: 5rem 1.5rem;
}

.hero h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
}

.hero p {
    font-size: 1.2rem;
    max-width: 600px;
    margin: 0 auto 2rem auto;
    color: #e2e8f0;
}

.btn-primary {
    display: inline-block;
    background-color: #3182ce;
    color: #ffffff;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    transition: background 0.2s ease;
}

.btn-primary:hover {
    background-color: #2b6cb0;
}

/* Layout Container */
.container {
    max-width: 1000px;
    margin: 3rem auto;
    padding: 0 1.5rem;
}

.section {
    margin-bottom: 3rem;
}

.section h2 {
    font-size: 1.8rem;
    margin-bottom: 1rem;
    color: #1a202c;
    border-bottom: 3rem;
}

/* Services Cards */
.services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
}

.card {
    background: #ffffff;
    padding: 1.5rem;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    border: 1px solid #e2e8f0;
}

.card h3 {
    margin-bottom: 0.5rem;
    color: #2b6cb0;
}

/* Footer */
footer {
    text-align: center;
    padding: 2rem;
    background-color: #1a202c;
    color: #a0aec0;
    font-size: 0.9rem;
}
